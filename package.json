{
  "name": "owguide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:release": "tsx scripts/validate-content.ts --release",
    "content:publish": "tsx scripts/publish-content.ts",
    "tauri": "tauri",
    "licenses": "tsx scripts/licenses.ts",
    "format": "prettier --write src scripts tests *.ts *.js *.json docs .github",
    "content:verify-live": "node --use-env-proxy --import tsx scripts/verify-live.ts",
    "schemas": "tsx scripts/schemas.ts",
    "content:capture": "node --use-env-proxy --import tsx scripts/capture-sources.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "5.0.3"
  }
}
